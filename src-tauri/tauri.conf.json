{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "boink",
  "version": "../package.json",
  "identifier": "com.willian.boink",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "boink",
        "width": 880,
        "height": 600,
        "minWidth": 640,
        "minHeight": 480,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Willian Felipe",
    "copyright": "© 2026 Willian Felipe. MIT License.",
    "category": "Utility",
    "shortDescription": "Paste a link, get the video.",
    "longDescription": "A small desktop video and audio downloader built on yt-dlp and ffmpeg.",
    "homepage": "https://github.com/w-felipe360/boink",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "bin/yt-dlp",
      "bin/ffmpeg"
    ],
    "resources": {
      "../LICENSE": "LICENSE.txt",
      "../THIRD-PARTY-NOTICES.md": "THIRD-PARTY-NOTICES.md"
    },
    "windows": {
      "nsis": {
        "languages": ["English", "PortugueseBR"],
        "displayLanguageSelector": false
      }
    }
  }
}
